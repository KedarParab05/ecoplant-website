# ── COPY THIS FILE TO .env AND FILL IN YOUR VALUES ──

# Server
PORT=5000
NODE_ENV=development

# JWT Secret (generate a random 64-char string)
JWT_SECRET=your_super_secret_jwt_key_here_change_this

# Anthropic (Claude AI)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Google AI / Vertex AI for Room Design
GEMINI_API_KEY=your_google_ai_studio_key
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=C:\absolute\path\to\service-account.json
GEMINI_ROOM_MODEL=gemini-1.5-flash
IMAGEN_MODEL=imagen-3.0-capability-001
ROOM_DESIGN_MAX_FILE_SIZE=10485760
ROOM_DESIGN_CACHE_TTL_MS=600000

# Razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Frontend origin (for CORS)
FRONTEND_URL=http://localhost:5500

# Data file path (JSON "database")
DB_PATH=./data/db.json
